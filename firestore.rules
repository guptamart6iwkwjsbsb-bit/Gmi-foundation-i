rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    function signed() { return request.auth != null; }
    function admin() { return signed() && exists(/databases/$(d)/documents/admins/$(request.auth.uid)); }
    match /products/{id} { allow read: if true; allow write: if admin(); }
    match /users/{uid} { allow read, write: if signed() && request.auth.uid == uid; }
    match /admins/{uid} { allow read: if signed() && request.auth.uid == uid; allow write: if false; }
    match /orders/{id} {
      allow create: if signed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.orderId == id
        && request.resource.data.status == 'Pending'
        && request.resource.data.payment == 'COD'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.address.keys().hasAll(['name','phone','line','city','pin']);
      allow read: if signed() && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['Pending','Confirmed','Packed','Shipped','Delivered','Cancelled'];
      allow delete: if false;
    }
  }
}
